{
  "name": "mclout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.14.0" },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/server.js",
    "check": "tsc --noEmit",
    "user:add": "npm run build && node dist/manage-users.js add",
    "db:backup": "npm run build && node dist/manage-users.js backup",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": { "dotenv": "^16.4.7", "express": "^4.21.2" },
  "devDependencies": { "@types/express": "^4.17.21", "@types/node": "^22.13.10", "typescript": "^5.8.2" }
}
